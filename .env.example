APP_NAME="ระบบติดตามและบริหารโครงการ เทศบาลตำบลบ้านแฮด"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://project-tracker.behn.go.th

# -------------------------------------------------------------
# การตั้งค่าฐานข้อมูล (Database Configuration)
# สำหรับ Plesk Hosting (HostAtom):
# 1. สร้าง Database ในเมนู Databases ของ Plesk
# 2. นำเข้าไฟล์ behn_project_tracker.sql ใน phpMyAdmin
# 3. ใส่ชื่อ Database, Username, Password ด้านล่างนี้
# -------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=project_tracker
DB_USERNAME=project_tracker
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
